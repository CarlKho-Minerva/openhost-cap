# Front proxy on the single OpenHost-routed port (:8080). The router terminates
# TLS and forwards plain HTTP here. {$CAP_PUBLIC_HOST} is injected by entrypoint.sh.
{
	admin off
	auto_https off
}

:8080 {
	# Cheap health endpoint — answers 200 even before Cap has finished booting.
	@health path /_healthz
	handle @health {
		respond "ok" 200
	}

	# Public S3 object access for presigned share/playback + upload URLs.
	# Path-style bucket route (/cap/*) -> MinIO. Force the upstream Host header to
	# the signed public host so MinIO's SigV4 presign validation matches, whatever
	# Host the router forwards.
	@s3 path /cap/*
	handle @s3 {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host {$CAP_PUBLIC_HOST}
		}
	}

	# @vercel/firewall gates rate-limited actions (Loom import, etc.) by probing
	# https://<Host>/.well-known/vercel/... and reading the status: a 404 means
	# "not on Vercel" → fail open (allow). But Cap's own Next.js middleware treats
	# that path as protected and 307-redirects it to /login, which the firewall reads
	# as an unexpected status and ABORTS the action ("An unexpected error occurred").
	# Pinning Host (below) is not enough — the 307 comes from Next.js, downstream of
	# the router's /.well-known/vercel/ public_path. So answer the probe here, before
	# it ever reaches Next.js, with a hard 404 → the firewall reliably fails open.
	@vercelfw path /.well-known/vercel/*
	handle @vercelfw {
		respond 404
	}

	# Everything else -> Cap (Next.js). Pin proto + Host to the public HTTPS origin.
	# Host is set (not just X-Forwarded-Host) because @vercel/firewall builds
	# https://<Host>/.well-known/vercel/... — with the raw host-mapped port it dies
	# (ECONNREFUSED); with the real public host it reaches the 404 handler above.
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {$CAP_PUBLIC_HOST}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {$CAP_PUBLIC_HOST}
		}
	}
}
