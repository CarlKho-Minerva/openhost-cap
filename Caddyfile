# Front proxy on the single OpenHost-routed port (:8080). The router terminates
# TLS and forwards plain HTTP here. {$CAP_PUBLIC_HOST} is injected by entrypoint.sh.
{
	admin off
	auto_https off
}

:8080 {
	# Access log for the only requests that answer "did anyone open this link":
	# share pages, embeds, and the player manifest. Everything else is skipped.
	# Written as JSON to a size-rotated file on app_data (10 MB, 5 kept), so it
	# survives a reload and rides along with the backup, unlike container stdout,
	# which is truncated on every restart.
	#
	# Deliberately dropped: Cookie and Authorization (session tokens), and the
	# signature-bearing query params, so the file is safe to read and to keep.
	# Deliberately kept: User-Agent, Referer, and X-Openhost-Is-Owner, so Carl's
	# own views are distinguishable from a real visitor's.
	log shares {
		output file {$CAP_ACCESS_LOG} {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>uri query {
					delete X-Amz-Signature
					delete X-Amz-Credential
					delete X-Amz-Security-Token
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
			}
		}
	}
	@unlogged not path /s/* /embed/* /api/playlist*
	log_skip @unlogged

	# Health endpoint. No longer a static 200: healthcheck.sh maintains
	# /run/cap-health/ok, and that flag only exists while a real archive write, a
	# real MinIO PUT/GET/DELETE, a MySQL SELECT 1 and a Next response all succeed.
	# The old static 200 stayed green through the whole 2026-09-15 upload outage.
	# Serving a file keeps the endpoint free (no process spawned per request) and
	# means it cannot wedge even if every backend is hung. Flag absent, during
	# boot or on a failing deep check, gives 503 with the reason as the body.
	@health path /_healthz
	handle @health {
		root * /run/cap-health
		@deep_ok file /ok
		handle @deep_ok {
			rewrite * /status
			file_server
		}
		handle {
			rewrite * /status
			file_server {
				status 503
			}
		}
	}

	# Public S3 object access for presigned share/playback + upload URLs.
	# Path-style bucket route (/cap/*) -> MinIO. Force the upstream Host header to
	# the signed public host so MinIO's SigV4 presign validation matches, whatever
	# Host the router forwards.
	@s3 path /cap/*
	handle @s3 {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host {$CAP_PUBLIC_HOST}
		}
	}

	# @vercel/firewall gates rate-limited actions (Loom import, etc.) by probing
	# https://<Host>/.well-known/vercel/... and reading the status: a 404 means
	# "not on Vercel" → fail open (allow). But Cap's own Next.js middleware treats
	# that path as protected and 307-redirects it to /login, which the firewall reads
	# as an unexpected status and ABORTS the action ("An unexpected error occurred").
	# Pinning Host (below) is not enough — the 307 comes from Next.js, downstream of
	# the router's /.well-known/vercel/ public_path. So answer the probe here, before
	# it ever reaches Next.js, with a hard 404 → the firewall reliably fails open.
	@vercelfw path /.well-known/vercel/*
	handle @vercelfw {
		respond 404
	}

	# Everything else -> Cap (Next.js). Pin proto + Host to the public HTTPS origin.
	# Host is set (not just X-Forwarded-Host) because @vercel/firewall builds
	# https://<Host>/.well-known/vercel/... — with the raw host-mapped port it dies
	# (ECONNREFUSED); with the real public host it reaches the 404 handler above.
	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up Host {$CAP_PUBLIC_HOST}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {$CAP_PUBLIC_HOST}
		}
	}
}
